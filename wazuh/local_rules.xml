<!-- Install within the Wazuh manager's local_rules.xml, inside <group>. -->
<group name="ztna,authentication,access_control,">
  <rule id="100501" level="5">
    <decoded_as>json</decoded_as>
    <field name="event">^login_denied$</field>
    <description>ZTNA gateway: failed sign-in for user $(user) from $(source_ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100502" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100501</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>ZTNA gateway: repeated failed sign-ins from $(source_ip)</description>
    <group>authentication_failed,brute_force,</group>
  </rule>

  <rule id="100503" level="7">
    <decoded_as>json</decoded_as>
    <field name="event">^access_denied$</field>
    <description>ZTNA gateway: application access denied for $(user) from $(source_ip)</description>
    <group>access_denied,</group>
  </rule>
</group>
